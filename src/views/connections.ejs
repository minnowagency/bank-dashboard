<%- include('_header', { title, reviewCount, active }) %>
<h1>Connections</h1>
<% if (!plaidReady) { %>
  <div class="banner"><strong>Plaid isn't configured on the server yet.</strong> Add the Plaid keys to <code>.env</code> (deploy/set-plaid-keys.sh) and restart.</div>
<% } else { %>
<p class="note">Each bank login is one connection. Linking opens Plaid's own window — your bank credentials go to Plaid, never to this server. New accounts arrive as <strong>Private</strong>; set names and visibility on the Accounts page.</p>

<div class="feed" style="margin-bottom:14px">
  <div class="row" style="grid-template-columns:1fr auto">
    <div><div class="desc">Link a bank login</div><div class="sub">Truist, American Express, or any other institution. Pulls up to 24 months of history.</div></div>
    <button class="primary" id="link-btn" type="button">Link a login</button>
  </div>
</div>

<% if (items.length === 0) { %>
  <div class="feed"><div class="empty">No connections yet.</div></div>
<% } else { %>
<div class="tablewrap">
<table>
  <tr><th>Institution</th><th>Accounts</th><th>Status</th><th>Last sync</th><th></th></tr>
  <% items.forEach(it => { %>
    <tr>
      <td><%= it.institution_name || 'Bank' %></td>
      <td class="note"><%= it.accounts.map(a => a.display_name || a.name).join(', ') || '—' %></td>
      <td><% if (it.status === 'ok') { %><span class="pos">OK</span><% } else { %><span class="owed">Needs attention</span><div class="note"><%= it.error %></div><% } %></td>
      <td class="note"><%= it.last_synced_at ? fmtDate(it.last_synced_at) : 'never' %></td>
      <td>
        <% if (it.status !== 'ok') { %><button type="button" class="primary js-fix" data-id="<%= it.id %>">Fix</button><% } %>
        <form method="post" action="/connections/<%= it.id %>/delete" class="inline js-confirm" data-confirm="Remove this connection? Its history stays; it just stops updating."><button>Remove</button></form>
      </td>
    </tr>
  <% }) %>
</table>
</div>
<% } %>

<p class="note" style="margin-top:12px">Data refreshes every 5 minutes with whatever Plaid has pulled from the bank; Plaid checks banks several times a day.</p>

<script src="https://cdn.plaid.com/link/v2/stable/link-initialize.js"></script>
<script src="/static/connections.js"></script>
<% } %>
<%- include('_footer') %>
