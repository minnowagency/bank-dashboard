<%- include('_header', { title, reviewCount, active }) %>
<h1>Rules</h1>
<% if (user.role === 'owner') { %>
  <form method="post" action="/settings/ai" class="filters">
    <input type="hidden" name="enabled" value="<%= aiOn ? '0' : '1' %>">
    <span>Categorize new transactions with AI: <strong><%= aiOn ? 'on' : 'off' %></strong></span>
    <button><%= aiOn ? 'Turn off' : 'Turn on' %></button>
  </form>
<% } %>
<p class="note">First matching rule wins, top to bottom. Rules only categorize transactions that have no category yet.</p>
<% rules.forEach(r => { %>
  <form id="re-<%= r.id %>" method="post" action="/rules/<%= r.id %>/edit"></form>
<% }) %>
<div class="tablewrap">
<table>
  <tr><th></th><th>Pattern</th><th>Account</th><th class="num">Amount</th><th>Category</th><th class="num">Matches</th><th></th><th></th></tr>
  <% rules.forEach(r => { %>
    <tr>
      <td>
        <% if (user.role === 'owner') { %>
          <form method="post" action="/rules/<%= r.id %>/move" class="inline"><input type="hidden" name="dir" value="up"><button>↑</button></form>
          <form method="post" action="/rules/<%= r.id %>/move" class="inline"><input type="hidden" name="dir" value="down"><button>↓</button></form>
        <% } %>
      </td>
      <td><input form="re-<%= r.id %>" name="pattern" value="<%= r.pattern %>" size="16"><% if (r.owner_only) { %> 🔒<% } %></td>
      <td><select form="re-<%= r.id %>" name="account_id"><option value="">any</option>
        <% if (user.role === 'owner' && r.account_id && !accounts.some(a => a.id === r.account_id)) { %><option value="" selected>(hidden account)</option><% } %>
        <% accounts.forEach(a => { %><option value="<%= a.id %>" <%= r.account_id === a.id ? 'selected' : '' %>><%= a.display_name || a.name %></option><% }) %></select></td>
      <td class="num"><input form="re-<%= r.id %>" name="amount" value="<%= r.amount_cents === null ? '' : (r.amount_cents / 100).toFixed(2) %>" size="8" placeholder="any"></td>
      <td><select form="re-<%= r.id %>" name="category_id">
        <% categories.forEach(c => { %><option value="<%= c.id %>" <%= r.category_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %></select></td>
      <td class="num"><%= r.matches %></td>
      <td><button form="re-<%= r.id %>" class="primary">Save</button></td>
      <td><form method="post" action="/rules/<%= r.id %>/delete" class="inline"><button>Delete</button></form></td>
    </tr>
  <% }) %>
</table>
</div>

<h2>Senders <span class="note">— who each wire-originating account belongs to</span></h2>
<% if (unlabeled.length > 0) { %>
  <p class="note">Wires only identify the sending account's last four digits. Name each account once and every payment from it — past and future — is filed the same way.</p>
  <div class="tablewrap" style="margin-bottom:12px">
  <table>
    <tr><th>From account</th><th>Into</th><th>Wires</th><th class="num">Total</th><th>Who sends it?</th><th>It's a…</th><th></th></tr>
    <% unlabeled.forEach(u => { const fid = `us-${u.last4}-${u.account_id}`; %>
      <form id="<%= fid %>" method="post" action="/senders">
        <input type="hidden" name="last4" value="<%= u.last4 %>"><input type="hidden" name="account_id" value="<%= u.account_id %>"></form>
      <tr>
        <td><strong>*<%= u.last4 %></strong></td>
        <td><%= u.account_name %></td>
        <td class="note"><%= u.count %> · last <%= fmtDate(u.latest) %></td>
        <td class="num pos"><%= fmtUSD(u.totalCents) %></td>
        <td><input form="<%= fid %>" name="name" value="<%= u.known_name || '' %>" placeholder="e.g. hppyc" size="12" required></td>
        <td><select form="<%= fid %>" name="category_id">
          <% senderCategoryOptions(categories).forEach(c => { %><option value="<%= c.id %>" <%= c.name === 'Revenue' ? 'selected' : '' %>><%= c.label %></option><% }) %>
        </select></td>
        <td><button form="<%= fid %>" class="primary">Label</button></td>
      </tr>
    <% }) %>
  </table>
  </div>
<% } %>
<% if (senders.length === 0) { %>
  <div class="feed"><div class="empty">None yet. Open an inbound wire on the Overview and use "Label sender".</div></div>
<% } else { %>
<div class="tablewrap">
<table>
  <tr><th>From account</th><th>Who</th><th>Into</th><th>Filed as</th><th></th></tr>
  <% senders.forEach(s => { %>
    <tr>
      <td>*<%= s.last4 %></td>
      <td><%= s.name %></td>
      <td><%= s.account_name %></td>
      <td><%= s.category_name %></td>
      <td><form method="post" action="/senders/<%= s.last4 %>/<%= encodeURIComponent(s.account_id) %>/delete" class="inline"><button>Remove</button></form></td>
    </tr>
  <% }) %>
</table>
</div>
<% } %>

<h2>Add rule</h2>
<form method="post" action="/rules" class="filters">
  <label>Description contains <input name="pattern" required></label>
  <label>Account <select name="account_id"><option value="">any</option>
    <% accounts.forEach(a => { %><option value="<%= a.id %>"><%= a.display_name || a.name %></option><% }) %></select></label>
  <label>Exact amount <input name="amount" size="8" placeholder="optional"></label>
  <label>Category <select name="category_id"><% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label>
  <% if (user.role === 'owner') { %><label><input type="checkbox" name="owner_only" value="1"> Only I can see this rule</label><% } %>
  <button class="primary">Add</button>
</form>

<h2>Categories</h2>
<div class="tablewrap">
<table>
  <% categories.forEach(c => { %>
    <tr><td><%= c.name %></td>
      <td><form method="post" action="/categories/<%= c.id %>/rename" class="inline">
        <input name="name" value="<%= c.name %>" size="16"><button>Rename</button></form></td></tr>
  <% }) %>
</table>
</div>
<form method="post" action="/categories" class="filters">
  <label>New category <input name="name" required></label><button class="primary">Add</button>
</form>
<%- include('_footer') %>
